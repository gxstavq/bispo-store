{
  "name": "bispo-store",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:rls": "node --test tests/supabase-rls.test.mjs",
    "test:rls:remote": "node --env-file=.env.local scripts/verify-remote-rls.mjs",
    "test:prelock:remote": "node --env-file=.env.local scripts/test-cart-prelocking-remote.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern .netlify",
    "audit:security": "node scripts/security-audit.mjs",
    "audit:bundle": "node --env-file=.env.local scripts/scan-build-secrets.mjs",
    "audit:deployment": "node --env-file=.env.local scripts/scan-public-deployment.mjs",
    "migrate": "node scripts/migrate-products-to-supabase.mjs",
    "supabase:migrate:products": "node scripts/migrate-products-to-supabase.mjs",
    "supabase:backup": "node scripts/backup-supabase-state.mjs",
    "supabase:create-first-admin": "powershell -ExecutionPolicy Bypass -File scripts/create-first-admin.ps1",
    "supabase:promote-admin": "node scripts/promote-supabase-admin.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.9",
    "lucide-react": "^0.468.0",
    "next": "^16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.5",
    "postcss": "8.5.24",
    "sharp": "0.35.0"
  },
  "type": "module"
}
